# tf-platform-connectivity — example variable values
# Copy this file to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars — it is gitignored.

# ---------------------------------------------------------------------------
# Identity and authentication (OIDC — no client secrets)
# ---------------------------------------------------------------------------
connectivity_subscription_id = "11111111-1111-1111-1111-111111111111"
tenant_id                    = "22222222-2222-2222-2222-222222222222"
client_id                    = "33333333-3333-3333-3333-333333333333"

# ---------------------------------------------------------------------------
# Deployment location and environment
# ---------------------------------------------------------------------------
location    = "westeurope"
environment = "prod"

# ---------------------------------------------------------------------------
# Hub network addressing
# Reserve this block centrally — do not change it once spokes are peered.
# ---------------------------------------------------------------------------
hub_address_space     = "10.0.0.0/22"
routing_address_space = "10.0.0.0/8"

# ---------------------------------------------------------------------------
# Optional features
# ---------------------------------------------------------------------------
enable_ddos             = false
threat_intelligence_mode = "Alert"
bastion_scale_units     = 2

# ---------------------------------------------------------------------------
# Private DNS
# ---------------------------------------------------------------------------
auto_registration_zone_name = "azure.contoso.internal"
excluded_private_link_zones = []

# ---------------------------------------------------------------------------
# On-premises DNS forwarding (leave empty for cloud-only deployments)
# ---------------------------------------------------------------------------
# dns_forwarding_rules = {
#   corp = {
#     domain_name              = "corp.contoso.com."
#     destination_ip_addresses = { primary = "10.250.0.53:53", secondary = "10.250.0.54:53" }
#   }
#   internal = {
#     domain_name              = "internal.contoso.com."
#     destination_ip_addresses = { primary = "10.250.0.53:53" }
#   }
# }

# ---------------------------------------------------------------------------
# Monitoring integration
# Option A: Read LAW ID from tf-platform-monitoring remote state (production path)
# ---------------------------------------------------------------------------
tfstate_rg = "rg-tfstate-prod"
tfstate_sa = "sttfstateprod001"
# log_analytics_workspace_id = null   # omit to use remote state

# Option B: Pass the LAW ID directly (CI pipelines that read remote state externally)
# log_analytics_workspace_id = "/subscriptions/11111111.../resourceGroups/rg-management/providers/Microsoft.OperationalInsights/workspaces/law-mgmt-prod"

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
enable_telemetry = true

# ---------------------------------------------------------------------------
# Tags
# ---------------------------------------------------------------------------
tags = {
  costcenter  = "CC-0100"
  landingzone = "platform-connectivity"
}
