# tf-subscription-vending — example variable values
# Copy to terraform.tfvars for local testing. Never commit terraform.tfvars.
# In CI, -backend-config="key=subvending/<env>/<name>.tfstate" is injected at init.

# ---------------------------------------------------------------------------
# Identity and authentication (OIDC — no client secrets)
# ---------------------------------------------------------------------------
tenant_id                            = "22222222-2222-2222-2222-222222222222"
platform_management_subscription_id = "11111111-1111-1111-1111-111111111111"
connectivity_subscription_id         = "33333333-3333-3333-3333-333333333333"

# ---------------------------------------------------------------------------
# Deployment target
# ---------------------------------------------------------------------------
environment = "prod"
location    = "westeurope"

# ---------------------------------------------------------------------------
# Remote state backend (reads connectivity, monitoring, sharedservices outputs)
# ---------------------------------------------------------------------------
tfstate_resource_group_name  = "rg-tfstate-platform"
tfstate_storage_account_name = "sttfstateplatform"
tfstate_container_name       = "tfstate"

# ---------------------------------------------------------------------------
# Billing model
# Choose ONE model and fill in the required fields for that model.
# ---------------------------------------------------------------------------
billing_model = "EA"

# EA (Enterprise Agreement)
billing_account_name       = "12345678"
billing_enrollment_account = "987654321"

# MCA (Microsoft Customer Agreement) — set billing_model = "MCA" and uncomment:
# billing_account_name         = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# billing_profile_name         = "yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"
# billing_invoice_section_name = "zzzzzzzz-zzzz-zzzz-zzzz-zzzzzzzzzzzz"

# MPA (Microsoft Partner Agreement) — set billing_model = "MPA" and uncomment:
# billing_account_name  = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# billing_customer_name = "yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"

# Existing subscription adoption — set billing_model = "Existing" and uncomment:
# subscription_id = "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"

# ---------------------------------------------------------------------------
# Subscription identity
# ---------------------------------------------------------------------------
subscription_display_name = "contoso-app-prod"
subscription_workload     = "Production"

# ---------------------------------------------------------------------------
# Governance — management group placement and budgets
# ---------------------------------------------------------------------------
management_group_id = "contoso-landingzones-prod"

# budget_amount       = 500
# budget_alert_emails = ["platform@contoso.com"]

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
create_virtual_network        = true
virtual_network_address_space = ["10.10.0.0/24"]
hub_peering_enabled           = true
link_all_dns_zones            = false

# Supply directly or let the module read from connectivity remote state:
# connectivity_hub_virtual_network_id = "/subscriptions/33333333.../resourceGroups/rg-plat-conn-prod-westeurope/providers/Microsoft.Network/virtualNetworks/vnet-plat-conn-prod-westeurope"

# ---------------------------------------------------------------------------
# Workload identity (CI/CD UAMI with GitHub Actions federation)
# ---------------------------------------------------------------------------
create_workload_identity = true
github_organization      = "contoso"
github_repository        = "app-repo"
github_environment       = "production"

# ---------------------------------------------------------------------------
# Entra group
# ---------------------------------------------------------------------------
create_entra_group               = true
entra_group_role_definition_name = "Contributor"
# entra_group_display_name       = "grp-sub-contoso-app-prod"
# entra_group_owners             = ["aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"]

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
enable_telemetry = true

# ---------------------------------------------------------------------------
# Tags
# ---------------------------------------------------------------------------
tags = {
  costcenter  = "CC-0200"
  landingzone = "subscription-vending"
  application = "contoso-app"
}
